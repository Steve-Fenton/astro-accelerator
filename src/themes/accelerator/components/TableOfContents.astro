---
// warning: This file is overwritten by Astro Accelerator

import type { Frontmatter } from "astro-accelerator-utils/types/Frontmatter";
import { SITE } from "@config";
import { Translations, Lang } from "@util/Languages";
import { Accelerator } from "astro-accelerator-utils";

const accelerator = new Accelerator(SITE);
const stats = new accelerator.statistics(
  "accelerator/components/TableOfContents.astro",
);
stats.start();

// Properties
type Props = {
  lang: string;
  frontmatter: Frontmatter;
  headings: { depth: number; slug: string; text: string }[];
  maxLevel?: number;
  expanded?: boolean | number;
};
let { lang, frontmatter, headings, maxLevel, expanded } =
  Astro.props satisfies Props;

// Language
const _ = Lang(lang);

// Logic
let openAttribute = null;
let openInteraction = null;

if (maxLevel == null) {
  maxLevel = 3;
}

const tocItems: {
  heading: (typeof headings)[number];
  children: (typeof headings)[number][];
}[] = [];
let currentParent: (typeof tocItems)[number] | undefined;

for (const heading of (headings ?? []).filter((h) => h.depth <= maxLevel)) {
  if (heading.depth === 3 && currentParent) {
    currentParent.children.push(heading);
  } else {
    const item = { heading, children: [] };
    tocItems.push(item);
    currentParent = heading.depth === 2 ? item : undefined;
  }
}

if (typeof expanded === "number") {
  openInteraction = expanded;
} else if (expanded === true) {
  openAttribute = "open";
}

stats.stop();
---

{
  headings?.length > 0 && (
    <nav class="page-toc" aria-label={_(Translations.aria.toc)}>
      <details open={openAttribute} data-openon={openInteraction}>
        <summary>{_(Translations.toc.title)}</summary>
        <ol>
          {tocItems.map(({ heading, children }) => (
            <li class={"toc-lev-" + heading.depth}>
              <a href={"#" + heading.slug}>{heading.text}</a>
              {children.length > 0 && (
                <ol>
                  {children.map((child) => (
                    <li class={"toc-lev-" + child.depth}>
                      <a href={"#" + child.slug}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<style is:global>
  /* Table of Contents (TOC) */

  .page-toc {
    font-size: var(--font-size-meta);
    margin: 0 0 var(--paragraph-margin) 0;

    & ol {
      list-style: square;
      margin-block: 0;
    }

    & li {
      & a {
        display: block;
        padding: 0.5rem;
        font-size: 1rem;
      }

      & ol {
        display: flex;
        flex-wrap: wrap;
        list-style: none;

        & li {
          text-align: left;
          hyphens: none;

          & a {
            border-radius: var(--block-radius);
            background-color: var(--aft-block);
            color: var(--fore-link);
            display: inline-block;
            margin-inline: 0 0.3rem;
            margin-block: 0 0.3rem;
            font-size: var(--font-size-meta);
          }

          & a:hover,
          a:focus {
            background-color: var(--fore-link-alt);
            color: var(--aft);
          }
        }
      }
    }
  }
</style>
